{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"extends": ["ultracite/biome/core", "ultracite/biome/react"],
	"files": {
		"includes": ["!.*", "!**/*.astro", "!**/*.svg"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineWidth": 100
	},
	"javascript": {
		"globals": ["WebSocketPair"],
		"formatter": {
			"indentStyle": "tab",
			"indentWidth": 4,
			"enabled": true,
			"quoteStyle": "single"
		}
	},
	"json": {
		"formatter": {
			"enabled": true,
			"indentStyle": "tab",
			"indentWidth": 4
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"correctness": {
				"useImportExtensions": {
					"fix": "safe",
					"level": "on"
				}
			},
			"performance": {
				"noImgElement": "off"
			},
			"style": {
				"noMagicNumbers": "off",
				"useBlockStatements": {
					"fix": "safe",
					"level": "on"
				},
				"useFilenamingConvention": "off"
			},
			"complexity": {
				"useOptionalChain": {
					"fix": "safe",
					"level": "on"
				}
			},
			"a11y": {
				"noNoninteractiveElementInteractions": "off",
				"useKeyWithClickEvents": "off",
				"noSvgWithoutTitle": "off"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.test.ts"],
			"linter": {
				"rules": {
					"suspicious": {
						"noEmptyBlockStatements": "off"
					}
				}
			}
		},
		{
			// CSS features use fallbacks; keep the existing progressive enhancement policy.
			"includes": ["**/*.css"],
			"linter": {
				"rules": {
					"suspicious": {
						"useBaseline": "off"
					}
				}
			}
		},
		{
			// The shared stylesheet intentionally layers component overrides in cascade order.
			"includes": ["src/styles/global.css"],
			"linter": {
				"rules": {
					"suspicious": {
						"noDuplicateSelectors": "off"
					}
				}
			}
		},
		{
			// Cloudflare Durable Object callbacks must be instance methods.
			"includes": ["src/worker/index.ts"],
			"linter": {
				"rules": {
					"style": {
						"useThisInClassMethods": "off"
					}
				}
			}
		}
	]
}
