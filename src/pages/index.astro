---
import Page, { generateMetadata } from '@/components/pages/HomePage.tsx';
import BaseLayout from '@/layouts/BaseLayout.astro';

const metadata = generateMetadata();
---

<BaseLayout metadata={metadata}>
	<Page />
</BaseLayout>

<script>
	import { initializeHomeCrawler } from '@/scripts/home-crawler.ts';

	const cleanup = initializeHomeCrawler();
	import.meta.hot?.dispose(cleanup);
</script>
