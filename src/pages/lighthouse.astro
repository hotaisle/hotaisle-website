---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { createPageMetadata } from '@/lib/metadata.ts';

const metadata = createPageMetadata({
	description: 'Latest Lighthouse performance, accessibility, best-practices, and SEO reports.',
	path: '/lighthouse',
	title: 'Lighthouse Reports',
});
---

<BaseLayout metadata={metadata}>
	<section class="border-border border-b">
		<div class="mx-auto max-w-4xl px-5 py-24 text-center lg:px-8">
			<p class="font-mono text-hot-orange-contrast text-xs uppercase tracking-[0.12em]">
				Performance reports
			</p>
			<h1 class="mt-5 font-display font-semibold text-4xl text-foreground tracking-tight sm:text-5xl">
				Lighthouse reports
			</h1>
			<p class="mx-auto mt-5 max-w-2xl text-lg text-muted-foreground leading-relaxed">
				The latest reports are generated during continuous integration and published with the
				site.
			</p>
		</div>
	</section>
</BaseLayout>
