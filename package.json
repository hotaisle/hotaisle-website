{
	"name": "hotaisle-next",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"preflight": "bun run scripts/preflight.ts",
		"generate:blog": "bun run scripts/generate_blog_data.ts",
		"generate:images": "bun run scripts/generate_image_variants.ts && bun run scripts/sync_blog_assets.ts",
		"generate:static-content": "bun run scripts/generate_static_content_data.ts",
		"generate:search": "bun run scripts/generate_search_data.ts",
		"generate:content": "bun run generate:blog && bun run generate:images && bun run generate:static-content && bun run generate:search",
		"watch:content": "bun run scripts/watch_content.ts",
		"test:toast": "bun run scripts/test_machine_status_toast.ts",
		"test:toast:prod": "bun run scripts/test_machine_status_production.ts",
		"prebuild": "bun run generate:content",
		"dev": "bun run preflight && bun run generate:content && (bun run watch:content & vinext dev --port 4174 --hostname localhost)",
		"build:internal": "bun run scripts/build_static.ts",
		"build": "bun run preflight && bun run build:internal",
		"preview": "bun run preflight && bun run build:internal && bun run scripts/preview_static.ts",
		"preview:vinext": "bun run preflight && vinext start",
		"preview:static": "bun run preview",
		"deploy": "bun run build && bun run wrangler deploy --config dist/server/wrangler.static.json",
		"test": "bun test",
		"tailwind:lint": "bun run scripts/fix_tailwind_lint.ts",
		"tailwind:lint:dry": "bun run scripts/fix_tailwind_lint.ts --dry-run",
		"lighthouse": "bun run preflight && bun run scripts/run_lighthouse.ts",
		"lighthouse:pages": "bun run scripts/generate_lighthouse_pages.ts",
		"check:imports": "bun run scripts/check_import_paths.ts",
		"typecheck": "bun run tsc -b",
		"check": "bun ./node_modules/ultracite/dist/index.js check && bun run check:imports && bun run typecheck",
		"check:finalize": "bun run check && bun run tailwind:lint:dry",
		"fix": "bun ./node_modules/ultracite/dist/index.js fix && bun run tailwind:lint"
	},
	"dependencies": {
		"@tailwindcss/typography": "^0.5.20",
		"clsx": "^2.1.1",
		"gray-matter": "^4.0.3",
		"lucide-react": "^1.22.0",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"react-router-dom": "^7.18.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-external-links": "^3.0.0",
		"rehype-highlight": "^7.0.2",
		"rehype-slug": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark": "^15.0.1",
		"remark-gfm": "^4.0.1",
		"remark-html": "^16.0.1",
		"remark-rehype": "^11.1.2",
		"tailwind-merge": "^3.6.0",
		"use-local-storage-state": "^19.5.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.1",
		"@cloudflare/vite-plugin": "^1.42.3",
		"@minify-html/node": "^0.18.1",
		"@tailwindcss/language-server": "^0.14.29",
		"@tailwindcss/postcss": "^4.3.1",
		"@tailwindcss/vite": "^4.3.1",
		"@types/node": "^26.0.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.3",
		"@vitejs/plugin-rsc": "^0.5.27",
		"bun-types": "^1.3.14",
		"lighthouse": "^13.4.0",
		"lightningcss": "^1.32.0",
		"oxc-minify": "^0.137.0",
		"rolldown": "^1.1.3",
		"sharp": "^0.35.2",
		"tailwindcss": "^4.3.1",
		"typescript": "^6.0.3",
		"ultracite": "^7.8.3",
		"vinext": "^0.1.8",
		"vite": "^8.1.0",
		"wrangler": "^4.105.0"
	}
}
